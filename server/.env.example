# MongoDB connection string (use your MongoDB Atlas free tier from GitHub Student Pack)
MONGODB_URI=mongodb://localhost:27017/codeclass

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Secret used to sign/hash teacher session tokens. Generate a long random string.
SESSION_SECRET=change_this_to_a_long_random_string

# Room code alphabet excludes ambiguous chars (0/O, 1/I/l)
ROOM_CODE_LENGTH=5

# Default room expiration (hours)
ROOM_EXPIRY_HOURS=12
